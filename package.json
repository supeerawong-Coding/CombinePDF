{
  "name": "combine-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "A private, browser-only PDF merging workspace.",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "node --check script.js && node --check vite.config.js && node --check playwright.config.js && node --check tests/combine.spec.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
